    if (!assertTrue(GetLocStringByKey("ssht_shatterscale") == "   ...Chancenkurve (100 = eins zu eins)", "w3string.byKey: ssht_shatterscale")) failed += 1;
    if (!assertTrue(GetLocStringByKey("ssht_killshatter") == "Alles zerfetzen, was Aard tötet", "w3string.byKey: ssht_killshatter")) failed += 1;
    if (!assertTrue(GetLocStringByKey("ssht_killshatterhumans") == "   ...auch Menschen", "w3string.byKey: ssht_killshatterhumans")) failed += 1;
