    if (!assertTrue(GetLocStringByKey("ssht_slomoscale") == "   ...Stärke (niedriger = stärker)", "w3string.byKey: ssht_slomoscale")) failed += 1;
    if (!assertTrue(GetLocStringByKey("ssht_slomotime") == "   ...Dauer, Sek.", "w3string.byKey: ssht_slomotime")) failed += 1;

