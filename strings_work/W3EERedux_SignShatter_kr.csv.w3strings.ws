    if (!assertTrue(GetLocStringByKey("ssht_ignipoise") == "이그니도 인간을 산산조각", "w3string.byKey: ssht_ignipoise")) failed += 1;
    if (!assertTrue(GetLocStringByKey("ssht_ignikill") == "이그니가 처치한 대상을 산산조각", "w3string.byKey: ssht_ignikill")) failed += 1;
