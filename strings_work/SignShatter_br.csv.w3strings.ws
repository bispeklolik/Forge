    if (!assertTrue(GetLocStringById(2114471006) == "Igni também estraçalha humanos", "w3string.byId: 2114471006")) failed += 1;
    if (!assertTrue(GetLocStringById(2114471007) == "Estraçalhar tudo que Igni matar", "w3string.byId: 2114471007")) failed += 1;
    if (!assertTrue(GetLocStringById(2114471008) == "Chance de câmera lenta ao estraçalhar", "w3string.byId: 2114471008")) failed += 1;
