    if (!assertTrue(GetLocStringById(2114478006) == "Mostrar números reais nas descrições das mutações", "w3string.byId: 2114478006")) failed += 1;
    if (!assertTrue(GetLocStringById(2114478007) == "Insetoide: restaurar a redução de dano removida", "w3string.byId: 2114478007")) failed += 1;
    if (!assertTrue(GetLocStringById(2114478008) == "   ...quanto mais fracos ficam os golpes seguintes, %", "w3string.byId: 2114478008")) failed += 1;
    if (!assertTrue(GetLocStringById(2114478009) == "   ...quantos segundos dura", "w3string.byId: 2114478009")) failed += 1;
