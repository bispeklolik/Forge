    // test by id
    if (!assertTrue(GetLocStringById(2114478000) == "Doplňky pro W3EE Redux", "w3string.byId: 2114478000")) failed += 1;
    if (!assertTrue(GetLocStringById(2114478001) == "Opravy Mutací", "w3string.byId: 2114478001")) failed += 1;
    if (!assertTrue(GetLocStringById(2114478002) == "Opravy mutací zapnuty", "w3string.byId: 2114478002")) failed += 1;
