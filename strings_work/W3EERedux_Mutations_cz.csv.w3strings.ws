    if (!assertTrue(GetLocStringById(2114478004) == "Hmyzak: rychlost odbouravani pri plnem adrenalinu, %", "w3string.byId: 2114478004")) failed += 1;
    if (!assertTrue(GetLocStringById(2114478005) == "Hmyzak: funguje jen v boji", "w3string.byId: 2114478005")) failed += 1;
