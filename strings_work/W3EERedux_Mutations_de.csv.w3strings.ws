    if (!assertTrue(GetLocStringById(2114478011) == "Charakterbogen: Zeichenintensität nach Abschwächung zeigen", "w3string.byId: 2114478011")) failed += 1;

    // test by key
    if (!assertTrue(GetLocStringByKey("w3eeredux_root") == "W3EE-Redux-Erweiterungen", "w3string.byKey: w3eeredux_root")) failed += 1;
    if (!assertTrue(GetLocStringByKey("mutf_menu") == "Mutations-Korrekturen", "w3string.byKey: mutf_menu")) failed += 1;
