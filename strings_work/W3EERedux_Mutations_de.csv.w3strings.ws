    if (!assertTrue(GetLocStringByKey("mutf_adrtop") == "Insektoid: Abbautempo bei voller Adrenalinleiste, %", "w3string.byKey: mutf_adrtop")) failed += 1;
    if (!assertTrue(GetLocStringByKey("mutf_combatonly") == "Insektoid: wirkt nur im Kampf", "w3string.byKey: mutf_combatonly")) failed += 1;
    if (!assertTrue(GetLocStringByKey("mutf_fixdesc") == "Echte Zahlen in Mutationsbeschreibungen zeigen", "w3string.byKey: mutf_fixdesc")) failed += 1;
    if (!assertTrue(GetLocStringByKey("insc_dmgredon") == "Insektoid: entfernte Schadensreduktion zurückholen", "w3string.byKey: insc_dmgredon")) failed += 1;
    if (!assertTrue(GetLocStringByKey("insc_dmgredperc") == "   ...wie viel schwächer Folgetreffer sind, %", "w3string.byKey: insc_dmgredperc")) failed += 1;
    if (!assertTrue(GetLocStringByKey("insc_dmgredwin") == "   ...wie viele Sekunden es anhält", "w3string.byKey: insc_dmgredwin")) failed += 1;
