    if (!assertTrue(GetLocStringById(2114477004) == "   ...2등급 강도, %", "w3string.byId: 2114477004")) failed += 1;
    if (!assertTrue(GetLocStringById(2114477005) == "   ...3등급 강도, %", "w3string.byId: 2114477005")) failed += 1;
    if (!assertTrue(GetLocStringById(2114477006) == "   ...4등급 강도, %", "w3string.byId: 2114477006")) failed += 1;
    if (!assertTrue(GetLocStringById(2114477007) == "설명에 그랜드마스터 수치를 괄호로 표시", "w3string.byId: 2114477007")) failed += 1;
    if (!assertTrue(GetLocStringById(2114477008) == "설명에 보너스 강도 줄 추가", "w3string.byId: 2114477008")) failed += 1;
    if (!assertTrue(GetLocStringById(2114477009) == "등급별 강도:", "w3string.byId: 2114477009")) failed += 1;

