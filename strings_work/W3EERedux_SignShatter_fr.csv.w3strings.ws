    if (!assertTrue(GetLocStringById(2114471012) == "   ...durée, sec", "w3string.byId: 2114471012")) failed += 1;

    // test by key
    if (!assertTrue(GetLocStringByKey("w3eeredux_root") == "Modules W3EE Redux", "w3string.byKey: w3eeredux_root")) failed += 1;
    if (!assertTrue(GetLocStringByKey("ssht_menu") == "Éclatement par Signe", "w3string.byKey: ssht_menu")) failed += 1;
